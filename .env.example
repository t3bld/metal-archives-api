PORT=3000

NEO4J_URI=bolt://localhost:7687
NEO4J_USERNAME=neo4j
NEO4J_PASSWORD=yourpassword
NEO4J_DATABASE=neo4j

METAL_ARCHIVES_BASE_URL=https://www.metal-archives.com

# BrightData Scraping Browser — required for cloud deployments (bypasses Cloudflare).
# Get this from brightdata.com -> Scraping Browser zone -> Access parameters.
# Leave unset to use local Chromium (dev only).
USE_BRIGHTDATA=false
BRIGHTDATA_WS_ENDPOINT=
